# Required deployment inputs (these are identifiers, not secrets).
PROJECT_ID=your-google-cloud-project-id
CLOUD_SQL_CONNECTION=your-google-cloud-project-id:europe-west1:whatomate-db
DB_USER=whatomate
DB_NAME=whatomate
ADMIN_EMAIL=admin@example.com
REDIS_HOST=10.0.0.3

# Fixed by firebase.json unless you intentionally change both files.
REGION=europe-west1
SERVICE=whatomate
FIREBASE_SITE=your-google-cloud-project-id

# Redis defaults. Set REDIS_TLS=true for a public TLS Redis provider.
REDIS_PORT=6379
REDIS_TLS=false

# Optional: required when REDIS_HOST is a private Memorystore address.
VPC_NETWORK=
VPC_SUBNET=

# Optional: enables Meta Embedded Signup. Manual account setup does not need it.
META_APP_ID=
META_CONFIG_ID=

# Media storage (chat/campaign images, videos, documents). Required in
# production: Cloud Run's local disk does not survive a redeploy, an instance
# restart, or a request landing on a different instance, so uploads silently
# disappear without this. A GCS bucket works via its S3-compatible XML
# interoperability API (create an HMAC key/secret for the runtime service
# account and put them in Secret Manager as whatomate-media-s3-key /
# whatomate-media-s3-secret — see scripts/prepare-secrets.sh).
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=https://storage.googleapis.com
